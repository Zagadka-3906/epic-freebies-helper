# Epic account. Quote local passwords containing $, # or backslashes with single quotes.
EPIC_EMAIL=
EPIC_PASSWORD=
# Optional multiline account list: email:password, one account per line.
# EPIC_ACCOUNTS='user1@example.com:password1
# user2@example.com:password2'
# Optional authenticator App Base32 secret, not the current six-digit code.
EPIC_TOTP_SECRET=

# Official DeepSeek only. Model is fixed to deepseek-flash (V4.1-Flash-1017).
DEEPSEEK_API_KEY=
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=45

# Browser: auto tries Camoufox, then Playwright Firefox.
BROWSER_BACKEND=auto
# true, false or virtual. Empty selects the platform default.
HEADLESS=
BROWSER_PROXY=
RETRY_ON_FAILURE=false
EXECUTION_TIMEOUT=120
RESPONSE_TIMEOUT=30
AUTH_MAX_ATTEMPTS=3
ENABLE_APSCHEDULER=false

# Optional notifications (both Telegram fields are needed).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional self-hosted WXPush; endpoint and token are required.
WXPUSH_ENDPOINT=
WXPUSH_TOKEN=
WXPUSH_USERID=
WXPUSH_TEMPLATE_ID=
WXPUSH_BASE_URL=
