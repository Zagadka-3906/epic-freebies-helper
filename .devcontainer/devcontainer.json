{
  "name": "Epic Freebies Helper",
  "image": "mcr.microsoft.com/playwright:v1.53.0-noble",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true,
      "toolsToInstall": "uv,ruff,black"
